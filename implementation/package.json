{
  "name": "nightlifez-monorepo",
  "private": true,
  "scripts": {
    "test:shared": "npm --prefix .. test --workspace=@nightlifez/shared",
    "test:web": "npm --prefix .. test --workspace=@nightlifez/web",
    "test:android": "npm --prefix android test",
    "build:web": "npm --prefix .. run build --workspace=@nightlifez/web",
    "lint:web": "npm --prefix .. run lint --workspace=@nightlifez/web"
  }
}
